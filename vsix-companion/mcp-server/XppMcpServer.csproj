<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>XppAiCopilotCompanion.McpServer</RootNamespace>
    <AssemblyName>XppMcpServer</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\DynamicsConfigurationReader.cs">
      <Link>DynamicsConfigurationReader.cs</Link>
    </Compile>
    <Compile Include="BridgeClient.cs" />
    <Compile Include="CodeExamples.cs" />
    <Compile Include="CodeSearch.cs" />
    <Compile Include="DocSearchHandler.cs" />
    <Compile Include="HtmlExtractor.cs" />
    <Compile Include="JsonHelpers.cs" />
    <Compile Include="McpLogger.cs" />
    <Compile Include="ModelObjectLister.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="ToolRouter.cs" />
    <Compile Include="XRefQuery.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
